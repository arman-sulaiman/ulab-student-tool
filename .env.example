GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=3001
HOST=127.0.0.1
# For a hosted installation, set your exact public origin:
# APP_ORIGIN=https://your-domain.example

# Run npm run setup-admin to create these locally. Copy values to your host.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Hosted PostgreSQL required for Vercel. Leave blank for local SQLite.
DATABASE_URL=
# Local persistent directory; ignored when DATABASE_URL is set.
DATA_DIR=data
AI_HOURLY_LIMIT=100
# Required for saving AI API keys in the admin dashboard. Generate once with:
# npm run setup-ai-encryption
# Preserve this value across redeployments; changing it makes saved keys unreadable.
AI_CONFIG_ENCRYPTION_KEY=
