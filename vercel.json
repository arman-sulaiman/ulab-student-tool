{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{fonts/**,public/ulab-logo.png}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/fonts/:path*",
      "destination": "/api"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    }
  ]
}
